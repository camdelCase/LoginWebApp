{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LoginWebApp;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Auth": {
    "Provider": "Local",
    "Local": {
      "Issuer": "https://localhost:7255",
      "Audience": "LoginWebApp",
      "TokenLifetimeMinutes": 60
    }
  }
}
